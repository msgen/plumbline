# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Alpaca market data + news (free tier is enough for research)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# SEC EDGAR requires a descriptive User-Agent with a contact email
SEC_USER_AGENT="Your Name your.email@example.com"

# Catalyst classifier (E9 bake-off); leave empty until you have access
JEV_API_KEY=
ANTHROPIC_API_KEY=

# Local paths
DATA_DIR=./data
